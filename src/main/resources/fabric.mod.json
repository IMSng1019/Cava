{
	"schemaVersion": 1,
	"id": "cava",
	"version": "${version}",
	"name": "Cava",
	"description": "把生物寻路 / 实体开销 / 红石三个子系统的内层循环搬到原生侧（Java 21 预览版 FFM + C++），行为与 native 关闭时逐 tick 一致。P0 只有骨架，不注入任何游戏逻辑。",
	"authors": [
		"Cava project"
	],
	"contact": {},
	"license": "CC0-1.0",
	"icon": "assets/cava/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"cava.Cava"
		],
		"client": [
			"cava.client.CavaClient"
		]
	},
	"mixins": [
		"cava.mixins.json",
		{
			"config": "cava.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.20.4",
		"java": ">=21",
		"fabric-api": "*"
	}
}
